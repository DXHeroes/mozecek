# Self-hosted Mozeček. Copy to .env next to compose.yml; never commit the result.

# Where the service is reachable from outside. No trailing slash.
MOZECEK_PUBLIC_URL=http://127.0.0.1:3000

# Operator token for /api/admin/** and the web UI. openssl rand -base64 32
MOZECEK_ADMIN_TOKEN=change-me

# Postgres password used by both services below.
POSTGRES_PASSWORD=change-me-too

# Google AI Studio key. Set MOZECEK_PROVIDER=fake to start the service without any model.
GEMINI_API_KEY=
MOZECEK_PROVIDER=gemini

# Optional, shown with their defaults.
# MOZECEK_LLM_MODEL=gemini-flash-latest
# MOZECEK_EMBEDDING_MODEL=gemini-embedding-2
# MOZECEK_EMBEDDING_DIM=1536
# MOZECEK_RATE_LIMIT_PER_MIN=120
# MOZECEK_SHORT_TTL_DAYS=7
# MOZECEK_DAILY_TOKEN_BUDGET=3000000
# MOZECEK_MAX_ATTACHMENT_MB=10
# MOZECEK_LOG_LEVEL=info
# TZ=Europe/Prague
